generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============ ENUMS ============

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum NutrientUnit {
  KCAL
  G
  MG
  MCG
  IU
}

enum Goal {
  WEIGHT_LOSS
  WEIGHT_GAIN
  MUSCLE_GROWTH
  FIT_BODY
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  ACTIVE
  VERY_ACTIVE
}

// ============ PROFILE ============

/// App-specific profile data for a Neon Auth (Stack Auth) user.
/// `id` is the Stack Auth user id (not locally generated) — identity and
/// credentials themselves live in Neon Auth, mirrored read-only into
/// `neon_auth.users_sync`. This table only holds what Neon Auth can't.
model Profile {
  id                    String         @id
  age                   Int?
  gender                String?
  weightKg              Decimal?       @map("weight_kg") @db.Decimal(5, 2)
  heightCm              Decimal?       @map("height_cm") @db.Decimal(5, 2)
  goal                  Goal?
  activityLevel         ActivityLevel? @map("activity_level")
  /// Set once the mandatory onboarding form is completed; null gates the
  /// user to /onboarding (see lib/session.ts requireOnboardedUser()).
  onboardingCompletedAt DateTime?      @map("onboarding_completed_at")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  mealEntries       MealEntry[]
  userTargets       UserTarget[]
  waterLogs         WaterLog[]
  notificationReads NotificationRead[]
  petState          PetState?

  @@map("profiles")
}

// ============ STREAK PET ============

/// The home page's virtual pet, whose body reflects the user's real logged
/// intake. Traits step by 1 (up or down, clamped to range) once per
/// completed calendar week — see lib/pet.ts.
model PetState {
  id                      String   @id
  /// 1 (slim) – 5 (heavy). Seeded from onboarding BMI on first creation.
  bodySize                Int      @default(3) @map("body_size")
  /// 1 (soft) – 5 (muscular), driven by weekly protein intake.
  muscleLevel             Int      @default(2) @map("muscle_level")
  /// 1 (lean) – 5 (puffy), driven by weekly fat intake.
  puffinessLevel          Int      @default(2) @map("puffiness_level")
  /// 1 (dim) – 3 (glowing), driven by weekly water intake.
  glowLevel               Int      @default(2) @map("glow_level")
  /// YYYY-MM-DD Monday of the last completed week already applied to the
  /// levels above — how getOrUpdatePetState() knows what's left to catch up.
  lastEvaluatedWeekStart  String   @map("last_evaluated_week_start")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("pet_states")
}

// ============ NOTIFICATIONS ============

/// Admin-broadcast in-app notification (Dashboard > Notifications).
model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  /// null = every user; set = only users onboarded with this goal.
  goal      Goal?
  createdAt DateTime @default(now()) @map("created_at")

  reads NotificationRead[]

  @@index([createdAt])
  @@map("notifications")
}

/// Per-user read receipt for a Notification. Presence of a row = read.
model NotificationRead {
  id             String   @id @default(cuid())
  notificationId String   @map("notification_id")
  userId         String   @map("user_id")
  readAt         DateTime @default(now()) @map("read_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  profile      Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@map("notification_reads")
}

// ============ NUTRITION ============

/// Admin-managed food category (Dashboard > Categories).
model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  foods Food[]

  @@map("categories")
}

/// Admin-managed food catalog (Dashboard > Foods). All nutrition values are
/// per 100g. Distinct from the USDA-driven meal-logging flow in
/// app/food/actions.ts, which stores its own per-meal nutrient snapshots.
model Food {
  id            String   @id @default(cuid())
  name          String   @unique
  burmeseName   String   @unique @map("burmese_name")
  categoryId    String   @map("category_id")
  calories      Decimal  @db.Decimal(6, 2)
  protein       Decimal  @db.Decimal(6, 2)
  carbohydrates Decimal  @db.Decimal(6, 2)
  fat           Decimal  @db.Decimal(6, 2)
  imageUrl      String   @map("image_url")
  /// ImageKit fileId for the image at `imageUrl`, so it can be reliably
  /// deleted/replaced later. ImageKit's own docs recommend storing this.
  imageFileId   String?  @map("image_file_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  category    Category    @relation(fields: [categoryId], references: [id])
  mealEntries MealEntry[]

  @@index([categoryId])
  @@index([name])
  @@map("foods")
}

model Nutrient {
  id              String       @id @default(cuid())
  code            String       @unique
  name            String
  unit            NutrientUnit
  dailyReference  Decimal?     @map("daily_reference") @db.Decimal(10, 2)
  referenceSource String?      @map("reference_source")
  referenceUrl    String?      @map("reference_url")
  isEnergy        Boolean       @default(false) @map("is_energy")
  sortOrder       Int          @default(0) @map("sort_order")
  createdAt       DateTime     @default(now()) @map("created_at")

  userTargets        UserTarget[]
  mealEntryNutrients MealEntryNutrient[]

  @@map("nutrients")
}

model UserTarget {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  nutrientId   String   @map("nutrient_id")
  targetAmount Decimal  @map("target_amount") @db.Decimal(10, 2)
  source       String?
  sourceUrl    String?  @map("source_url")
  updatedAt    DateTime @updatedAt @map("updated_at")

  profile  Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  nutrient Nutrient @relation(fields: [nutrientId], references: [id])

  @@unique([userId, nutrientId])
  @@map("user_targets")
}

model MealEntry {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id")
  foodId             String?   @map("food_id")
  foodName           String    @map("food_name")
  foodBrand          String?  @map("food_brand")
  source             String?  @default("local")
  servingDescription String?  @map("serving_description")
  servingGrams       Decimal  @map("serving_grams") @db.Decimal(10, 3)
  quantity           Decimal  @default(1) @db.Decimal(6, 2)
  mealType           MealType @map("meal_type")
  eatenAt            DateTime @map("eaten_at")
  createdAt          DateTime @default(now()) @map("created_at")

  profile   Profile              @relation(fields: [userId], references: [id], onDelete: Cascade)
  food      Food?                @relation(fields: [foodId], references: [id])
  nutrients MealEntryNutrient[]

  @@index([userId, eatenAt])
  @@map("meal_entries")
}

model MealEntryNutrient {
  id             String  @id @default(cuid())
  mealEntryId    String  @map("meal_entry_id")
  nutrientId     String  @map("nutrient_id")
  amountConsumed Decimal @map("amount_consumed") @db.Decimal(12, 4)

  mealEntry MealEntry @relation(fields: [mealEntryId], references: [id], onDelete: Cascade)
  nutrient  Nutrient  @relation(fields: [nutrientId], references: [id])

  @@unique([mealEntryId, nutrientId])
  @@map("meal_entry_nutrients")
}

model WaterLog {
  id       String   @id @default(cuid())
  userId   String   @map("user_id")
  amountMl Int      @map("amount_ml")
  loggedAt DateTime @default(now()) @map("logged_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
  @@map("water_logs")
}
